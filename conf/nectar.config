process {

    // This matches the VM we are using.
    resourceLimits = [
        cpus: 30,
        memory: 60.GB
    ]

    withLabel: autoindex {
        cpus = 20
        memory = 50.GB
    }

    // This matches resources on our VM.
    withLabel: process_single {
        cpus = 1
        // Reduce memory so the VM can still be used if a small
        // job is running but account for possible large serial data processing.
        memory = 50.GB
    }

    withLabel: process_low {
        cpus = 4
        memory = 50.GB
    }

    withLabel: process_medium {
        cpus = 15
        memory = 50.GB
    }

    withLabel: process_high {
        cpus = 30
        memory = 60.GB
    }

    // If specified, bind /dev/shm to /tmp.
    containerOptions = '--bind /dev/shm:/tmp'

}
