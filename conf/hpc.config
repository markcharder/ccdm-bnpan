// Config is based on Pawsey Setonix HPC environment in Western Australia.
// General parameters can be used or the user can change this config for
// their environment as needed.
params {

        max_cpus = 112
        max_memory = 224.GB
        max_time = 24.h
        account = "${System.getenv('SLURM_ACCOUNT') ?: 'username'}" // Set to HPC account name.

        }

singularity {

    enabled = true
    cacheDir = "${System.getenv('MYSCRATCH') ?: launchDir}/.nxf_singularity"
    autoMounts = true
    envWhitelist = "SINGULARITY_BINDPATH, SINGULARITYENV_LD_LIBRARY_PATH, SINGULARITYENV_LD_PRELOAD"
    runOptions = "--rocm"

}

process {

    resourceLimits = [ memory: 230.GB, cpus: 64 ]
    containerOptions = '--bind /tmp:/tmp'
    executor = 'slurm'

    // generic
    withLabel: autoindex {
        cpus = 48
        memory = 200.GB
        time = 24.h
    }

    withLabel: process_medium {
        cpus = 30
        time = 24.h
    }

    withLabel: process_high {
        cpus = 48
        time = 24.h
        memory = 96.GB
    }

    // rnaseq
    withName: varus {
        errorStrategy = 'retry'
        maxRetries = 3
        cpus = 20
        memory = 40.GB
        time = 24.h
    }
    withName: mask_unplaced_contigs {
        cpus = 48
        memory = 96.GB
        time = 15.h
    }
    withName: hisat2_index {
        cpus = 30
        memory = 120.GB
        time = 24.h
    }
    withName: hisat2_align {
        cpus = 20
        memory = 60.GB
        time = 12.h
    }
    withName: samtools_sort {
        cpus = 20
        memory = 60.GB
        time = 12.h
    }

    // gquals
    withName: synteny_plot {
        cpus = 1
        memory = 24.GB
        time = 1.h
    }

    // braker3
    withName: download_protein_db {
        cpus = 1
        memory = 2.GB
        time = 24.h
    }
    withName: braker3 {
        cpus = 40
        memory = 120.GB
        time = 24.h
    }
    withName: braker3_one_genome {
        cpus = 40
        memory = 120.GB
        time = 24.h
    }

    // interpro
    withName: split_fasta {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }

    withName: interproscan {
        cpus = 16
        memory = 48.GB
        time = 12.h
    }

    // graphcall
    withName: vg_filter {
        cpus = 48
    }

}
