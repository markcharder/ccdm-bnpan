params {

    // IO paths.
    braker3_masked_genomes = "${projectDir}/data/processed/rnaseq/masked_genomes_full/"
    braker3_out_dir = "${projectDir}/data/processed/braker3/"
    braker3_bam_dir = "${projectDir}/data/processed/rnaseq/alignments/"
    braker3_prot_db_url = "https://bioinf.uni-greifswald.de/bioinf/partitioned_odb11/Viridiplantae.fa.gz"
    braker3_prot_db_name = "Viridiplantae.fa.gz"

    braker3_cache = "${projectDir}/.braker3/"
    braker3_prot_db_cache = "${projectDir}/data/databases"

    // Which genome to run for the initial braker3 training.
    braker3_first = "Westar"

    // Whether or not to just run one or run all genomes.
    braker3_skip_rest = false

    // Braker-specific. In the first braker3 run, the AUGUSTUS
    // parameters will be recorded under this species in AUGUSTUS
    // config.
    braker3_species_name = "bnpan"

}