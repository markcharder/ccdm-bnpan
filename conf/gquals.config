params {

    gquals_reference = "${projectDir}/data/gquals/ref/zs11_chromosomes.fa"
    gquals_scaffolded = "${projectDir}/data/gquals/scaf/*{.fa,fasta,fna}"
    gquals_out_dir = "${projectDir}/data/processed/gquals"
    gquals_cache = "${projectDir}/.gquals"
    gquals_busco_lineage = "brassicales_odb12"
    gquals_busco_lineage_url = "https://busco-data.ezlab.org/v5/data/lineages/brassicales_odb12.2025-07-01.tar.gz"
    gquals_proteins = "${projectDir}/data/processed/braker3_renamed/"

}
