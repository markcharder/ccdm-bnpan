
process {

    resourceLimits = [ memory: 60.GB, cpus: 32 ]

    // If process resources are forgotten,
    // use only a minimum amount of compute.
    cpus = 1
    memory = 2.GB

    // Try to complete anything running and then quit.
    // Balance between saving resources on a failed job
    // and potentially cancelling tasks that may succeed.
    errorStrategy = 'finish'

    // These are set by the user for their system.
    // Defaults are based on the machine used for development.
    // Different profiles may override them.

    // Fine-grained control of resource allocation for 
    // different processes.
    withLabel: 'small' {

        cpus = 1
        memory = 2.GB

    }

    withLabel: 'medium' {

        cpus = 12
        memory = 24.GB

    }

    withLabel: 'high' {

        cpus = 20
        memory = 40.GB
        maxForks = 1

    }

    withName: mask_unplaced_contigs {
    
        cpus = 16
        memory = 32.GB

    }

    withName: hisat2_index {

        cpus = 12
        memory = 32.GB

    }

    withName: hisat2_align {

        cpus = 16
        memory = 32.GB
    
    }

    withName: samtools_sort {

        cpus = 12
        memory = 32.GB

    }

    withName: varus {

        cpus = 12
        memory = 32.GB

    }

    withName: download_protein_db {

        cpus = 1
        memory = 2.GB

    }

    withName: braker3_one_genome {

        cpus = 16
        memory = 32.GB

    }

    withName: braker3 {

        cpus = 16
        memory = 32.GB

    }

    withName: split_fasta {

        cpus = 4
        memory = 8.GB

    }

    withName: interproscan {

        cpus = 12
        memory = 32.GB

    }

}