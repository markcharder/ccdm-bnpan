params {
    
    graphmap_cache = "${projectDir}/.graphmap"
    graphmap_out_dir = "${projectDir}/data/graphmap/out"
    graphmap_graph = "${projectDir}/data/graphmap/graph/ccdm-bnpan.gbz"
    graphmap_haplotypes = "${projectDir}/data/graphmap/graph/ccdm-bnpan.hapl"
    graphmap_reads_illumina = "${projectDir}/data/graphmap/reads_illumina/"
    graphmap_reads_long = "${projectDir}/data/graphmap/reads_long/"
    graphmap_variety_ids = "${projectDir}/data/graphmap/conf/variety_ids.txt"
    graphmap_variety_ids_long = "${projectDir}/data/graphmap/conf/variety_ids_long.txt"
    graphmap_type = "short"  // Options: "short" or "long"

}