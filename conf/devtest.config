params {

    // rnaseq
    rna_seq_dir = "${projectDir}/tests//data/raw/rnaseq/" // This is only used if aligner is set to hisat2.
    genomes_dir = "${projectDir}/tests/data/raw/genomes/"
    panhite_dir = "${projectDir}/tests/data/processed/panHiTE/"
    unplaced_contigs_dir = "${projectDir}/tests/data/raw/unplaced_contigs/"
    rnaseq_out_dir = "${projectDir}/tests/data/processed/rnaseq/"
    varus_batchSize = 5000
    varus_maxBatches = 20
    varus_use_tmp = false // Whether or not to use /tmp for varus.
    varus_vsk = 'PM:juncea'
    repeats_gffs = "${projectDir}/tests/data/processed/panHiTE/pan_annotate_genomes/*/*{fa,fasta}.sorted.gff"
    te_library = "${projectDir}/tests/data/processed/panHiTE/panTE.fa"

    // braker3
    braker3_masked_genomes = "${projectDir}/tests/data/processed/rnaseq/masked_genomes_full/"
    braker3_out_dir = "${projectDir}/tests/data/processed/braker3/"
    braker3_bam_dir = "${projectDir}/tests/data/processed/rnaseq/alignments/"
    braker3_cache = "${projectDir}/tests/.braker3/"
    braker3_first = "mycanola1"
    braker3_skip_rest = true
    braker3_species_name = "bnpan"

    // synteny
    gquals_reference = "${projectDir}/tests/data/raw/mycanola1_A.fa"
    gquals_scaffolded = "${projectDir}/tests/data/raw/mycanola{2,3}_A.fa"
    gquals_out_dir = "${projectDir}/tests/data/processed/gquals"
    gquals_cache = "${projectDir}/tests/.gquals"

    // graphprep
    graphprep_graphs = "${projectDir}/tests/data/graph/*gfa"

    // graphmap
    graphmap_out_dir = "${projectDir}/tests/data/processed/graphmap/"
    graphmap_cache = "${projectDir}/tests/.graphmap"
    graphmap_graph = "${projectDir}/tests/data/graph/combined.hap.gbz"
    graphmap_minimizer = "${projectDir}/tests/data/graph/combined.hap.min"
    graphmap_dist = "${projectDir}/tests/data/graph/combined.hap.dist"
    graphmap_zipcodes = "${projectDir}/tests/data/graph/combined.hap.zipcodes"
    graphmap_shortreads = "${projectDir}/tests/data/rnaseq/*gz"
    graphmap_shortdo = true

}