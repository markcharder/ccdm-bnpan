params {


    // How many proteins for interpro to process per chunk.
    interpro_chunk_size = 500

    // Where to store the interpo db cache.
    interpro_db_cache = "${projectDir}/data/processed/databases/"
    interpro_db_name = "interproscan-5.76-107.0"
    interpro_db_url = "https://ftp.ebi.ac.uk/pub/software/unix/iprscan/5/5.76-107.0/interproscan-5.76-107.0-64-bit.tar.gz"

}