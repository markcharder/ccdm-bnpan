params {

    // User-defined run options.
    aligner = 'varus' // Either hisat2 or varus.
    rna_seq_dir = "${projectDir}/data/raw/rnaseq/" // This is only used if aligner is set to hisat2.

    // Get inputs from panhite annotation and the genomes directory it used.
    genomes_dir = "${projectDir}/data/raw/genomes/"
    unplaced_contigs_dir = "${projectDir}/data/raw/unplaced_contigs/"
    mask_unplaced = true

    // Output to a new directory.
    rnaseq_out_dir = "${projectDir}/data/processed/rnaseq/"

    // Varus parameters.
    varus_genus = 'Brassica'
    varus_species = 'napus'
    varus_batchSize = 50000
    varus_maxBatches = 750
    varus_use_tmp = true // Whether or not to use /tmp for varus.
    varus_vsk = 'PM:juncea,CN115125:nigra,W03:oleracea,Chiifu:rapa,ECD04:rapa'
    repeats_gffs = "${projectDir}/data/processed/panHiTE/pan_annotate_genomes/*/*{fa,fasta}.sorted.gff"
    te_library = "${projectDir}/data/processed/panHiTE/panTE.fa"

    // Can use to stop at building the index.
    index_only = false

    // Determine whether to use additional unplaced contigs.
    use_unplaced = true

}