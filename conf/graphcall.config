params {
    
    graphcall_cache = "${projectDir}/.graphcall"
    graphcall_out_dir = "${projectDir}/data/graphcall/out"
    graphcall_graph = "${projectDir}/data/graphcall/graph/ccdm-bnpan.gbz"
    graphcall_gams = "${projectDir}/data/graphcall/gams/*.gam"
    graphcall_vg_refsample = "X5A_ref"
    graphcall_vg_filtered_gams = "${projectDir}/data/graphcall/out/*-filtered.gam"
    graphcall_bcftools_csize = 20
    graphcall_bcftools_vcfz = "${projectDir}/data/vcfbub/out/*-vb.vcf.gz"

}