params {
    
    singularity_cache = "${System.getenv('NXF_SINGULARITY_CACHEDIR') ?: projectDir}/.nxf_singularity"

}

singularity {
    
    cacheDir = "${params.singularity_cache}"
    autoMounts = true
    enabled = true

}

process {

    withLabel: 'gwastools' {
        container = "${projectDir}/envs/containers/gwastools.sif"
    }

    withLabel: 'deepvariant' {
        container = "docker://google/deepvariant:pangenome_aware_deepvariant-1.9.0"
        containerOptions = "--bind /usr/lib/locale/:/usr/lib/locale/"
    }

    withLabel: 'samtools' {
        container = "docker://staphb/samtools:1.23"
    }

    withLabel: 'bcftools' {
        container = "docker://staphb/bcftools:1.23"
    }

    withLabel: 'busco' {
        container = "docker://nanozoo/busco:5.8.3--f62051d"
    }

    withLabel: 'graphmap|graphcall|graphtools' {
        container = "${projectDir}/envs/containers/graphtools.sif"
    }

    withLabel: 'rscript' {
        container = "docker://nanozoo/ggplot2:3.5.1--819814a"
    }

    withLabel: 'minimap2' {
        container = "docker://cuhkhaosun/minimap2:20251211"
    }

    withLabel: 'braker3' {
        container = "docker://teambraker/braker3:v3.0.7.6"
    }

    withLabel: 'repeatmasker' {
        container = "docker://veupathdb/repeatmasker:1.4"
    }

    withLabel: 'hisat2' {
        container = "docker://pegi3s/hisat2:2.2.0"
    }

    withLabel: 'bedtools' {
        container = "docker://pegi3s/bedtools:2.31.0"
    }

    withLabel: 'samtools' {
        container = "docker://staphb/samtools:1.22.1"
    }

    withLabel: 'varus' {
        container = "${projectDir}/envs/containers/varus.sif" // Set to local sift built with envs/containers/varus.def
    }

    withLabel: 'assemprep' {
        container = "${projectDir}/envs/containers/assemprep.sif" // Set to local sift built with envs/containers/assemprep.def
    }
}