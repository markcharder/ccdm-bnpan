
params {

    // --- panHiTE IO --- //
    pan_genomes_dir = "${projectDir}/tests/data/raw/genomes/"
    genome_list = "${projectDir}/tests/data/conf/genome_list.txt"
    out_dir = "${projectDir}/tests/data/processed/panHiTE/"
    shared_prev_TE = "${projectDir}/tests/data/processed/panHiTE/shared_prev_TE.fa"

    // --- braker3 IO --- //
    rna_seq_dir = "${projectDir}/tests/data/rnaseq"
    // Needs fixing - import truncated panHiTE output for testing and make available in permanent directory.
    repeats_gffs = "${projectDir}/tests/data/processed/panHiTE/pan_annotate_genomes/*/*fa.sorted.gff"
    braker3_dir = "${projectDir}/tests/data/processed/braker3_annotation/"
    // It will still use the same db location but in the test directory.
    protein_db_cache = "$projectDir/tests/data/databases"
   
    // --- interpro IO --- //
    protein_fastas = "${projectDir}/tests/data/raw/proteins/*/braker.aa"
    interpro_out_dir = "${projectDir}/tests/data/processed/interpro"
    interpro_db_cache = "${projectDir}/tests/data/databases"
    interpro_db_name = "interproscan-5.76-107.0"
    // Reduce number of proteins to process per chunk.
    interpro_chunk_size = 100

    // --- varus IO --- //
    // Varus fails, and so does braker, in test mode, because it cannot retrieve
    // any quality RNA seq if the genome is truncated to a very small size.
    // Varus testing must be separated from braker testing - need to double-check and bug-fix if necessary.
    varus_inputs = "${projectDir}/tests/data/raw/genomes/mycanola1_A.fa"

    // --- graphprep --- //
    // Test on two very small identical gfas.
    graphprep_graphs = "${projectDir}/tests/data/graph/*gfa"

}