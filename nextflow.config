// Resume and run workflows in hidden directory where they are launched.
workDir = "$launchDir/.nextflow/work"
resume = true

manifest {
    name            = 'ccdm-bnpan'
    author          = 'Mark C Derbyshire'
    homePage        = 'https://github.com/markcharder/ccdm-bnpan'
    description     = 'Workflows used for Brassica napus pan-genomics at the CCDM.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}

trace {
    enabled = true
    file = "$launchDir/.nextflow/pipeline_info/execution_trace_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())}.txt"
}

timeline {
    enabled = true
    file = "$launchDir/.nextflow/pipeline_info/execution_timeline_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())}.html"
}

report {
    enabled = true
    file = "$launchDir/.nextflow/pipeline_info/execution_report_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())}.html"
}

dag {
    enabled = true
    file = "$launchDir/.nextflow/pipeline_info/pipeline_dag_${new java.text.SimpleDateFormat('yyyy-MM-dd_HH-mm-ss').format(new java.util.Date())}.svg"
}

params {

    help = false
    version = false

    // Decide which workflow to run.
    workflow = '' // Options: rnaseq, braker3, interproscan, gquals, graphmap

    // Get IO files from these directories.
    genomes_dir = "${projectDir}/data/raw/genomes/"
    output_dir = ""
    store_dir = ""

    // Used in development to activate a test workflow.
    dev_test = false

}

includeConfig './conf/base.config'
includeConfig './conf/braker3.config'
includeConfig './conf/interpro.config'
includeConfig './conf/rnaseq.config'
includeConfig './conf/gquals.config'
includeConfig './conf/graphmap.config'
includeConfig './conf/graphcall.config'
includeConfig './conf/gwas.config'
includeConfig './conf/assemprep.config'

profiles {

    singularity {
        includeConfig './conf/singularity.config'
    }

    hpc {
        includeConfig './conf/hpc.config'
    }

    test {
        includeConfig './conf/test.config'
    }

    devtest {
        includeConfig './conf/devtest.config'
    }

    nectar {
        includeConfig './conf/nectar.config'
    }

}
